APP_PORT=3333
GOOGLE_API_KEY=
RAILWAY_ENVIRONMENT=development
SWAGGER_USERS='[[]]'
WEB_URL=https://petccufpb.com.br
# Admin (autenticação do painel em /admin)
# Gere o hash com: node -e "require('bcrypt').hash('SENHA', 12).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_NAME=pet_admin_token
# Databases
MIGRATE_DATABASE_URL="postgresql://username:password@host:port"
POSTGRES_URL="postgresql://POSTGRES_USER:POSTGRES_PASS@DB_HOST:POSTGRES_PORT/DB_NAME"
REDIS_URL=""
# Infra Drivers
# MAIL_DRIVER aceita: gmail | nodemailer | sendgrid | ethereal
MAIL_DRIVER=gmail
# MAIL_HOST e MAIL_PORT são usados apenas com MAIL_DRIVER=nodemailer (conexão TLS)
MAIL_HOST=
MAIL_PORT=465
# SENDGRID_API_KEY é usado apenas com MAIL_DRIVER=sendgrid
SENDGRID_API_KEY=
# Providers
MAIL_PASS=
MAIL_USER=petcc@ci.ufpb.br
